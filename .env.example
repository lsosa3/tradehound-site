# Optional. URL that the /contact form POSTs JSON to (e.g. an API Gateway
# endpoint backed by Lambda + SES, or a form service).
# If unset, the contact form falls back to opening the visitor's mail client.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional. PostHog project API key (starts with phc_). When set, the site shows
# a cookie consent banner and loads PostHog only after the visitor accepts.
# If unset, there is no banner and no analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host. Defaults to https://us.i.posthog.com; use
# https://eu.i.posthog.com for an EU-region project.
NEXT_PUBLIC_POSTHOG_HOST=
